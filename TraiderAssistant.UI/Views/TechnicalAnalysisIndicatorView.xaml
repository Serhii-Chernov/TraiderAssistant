<UserControl x:Class="TraiderAssistant.UI.Views.TechnicalAnalysisIndicatorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes">

    <Viewbox StretchDirection="DownOnly">
        <StackPanel Margin="10">
            <TextBlock x:Name="TechnicalAnalysisNameTextBox"
                       Text="{Binding TechnicalAnalysisName, RelativeSource={RelativeSource AncestorType=UserControl}}"
                       Style="{StaticResource MaterialDesignHeadline5TextBlock}"
                       TextAlignment="Center" Margin="0,0,0,15" FontWeight="Medium" Foreground="#424242"/>

            <Canvas x:Name="AnalysisCanvas" Width="400" Height="200" Background="Transparent" />

            <TextBlock x:Name="TechnicalAnalysisTextTextBox"
                       Text="{Binding TechnicalAnalysisText, RelativeSource={RelativeSource AncestorType=UserControl}}"
                       Style="{StaticResource MaterialDesignHeadline6TextBlock}"
                       TextAlignment="Center" Margin="0,15,0,0" FontWeight="Bold" Foreground="#616161"/>
        </StackPanel>
    </Viewbox>
</UserControl>
